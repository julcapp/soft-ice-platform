{
  "name": "roylty-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && node scripts/build.js",
    "prisma:merge": "node scripts/merge-promotion-prisma.js",
    "prisma:check-integrated": "node scripts/merge-promotion-prisma.js --check",
    "prisma:generate": "npm run prisma:merge && prisma generate",
    "prisma:migrate": "npm run prisma:merge && prisma migrate dev",
    "prisma:validate": "npm run prisma:merge && prisma validate",
    "promotion:notifications": "node scripts/run-promotion-pre-notifications.js",
    "test": "npm run prisma:merge && node --test tests/*.test.js",
    "max:resolve-chat-id": "node scripts/resolve-max-chat-id.js",
    "photo:publish-smoke": "node scripts/photo-publish-smoke.js",
    "private-channel:renewals": "node scripts/run-private-channel-renewals.js",
    "yookassa:reports:imap": "node scripts/import-yookassa-reports-from-yandex.js",
    "yookassa:reports:scheduled": "node scripts/run-yookassa-report-schedule.js",
    "operations:escalation-delivery": "node scripts/run-admin-operations-escalation-delivery.js",
    "crm:direct-delivery": "node scripts/run-crm-direct-message-delivery.js",
    "dev": "node src/main.js",
    "start": "node src/main.js",
    "bot:test:configure": "node scripts/configure-telegram-test-bot.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "prisma": "^5.0.0",
    "express": "^4.18.0"
  }
}
