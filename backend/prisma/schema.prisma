  id             String                       @id
  organizationId String
  locationId     String
  stockItemId    String?
  sku            String
  movementType   InventoryRuntimeMovementType
  quantity       Int
  unit           String
  operationType  InventoryOperationType
  operationId    String
  operatorId     String?
