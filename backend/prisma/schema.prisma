generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  DISPENSING
  COMPLETED
  FAILED
  CANCELLED
  CANCELLED_BY_CUSTOMER
}

enum MachineStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  BLOCKED
}

enum OrganizationMemberStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganizationLocationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRoleType {
  OWNER
  ADMINISTRATOR
  MANAGER
  OPERATOR
  SERVICE_SPECIALIST
  MACHINE_RESPONSIBLE
  LOCATION_RESPONSIBLE
  FINANCIALLY_RESPONSIBLE
}

enum OrganizationResponsibilityScope {
  ORGANIZATION
  UNIT
  LOCATION
  MACHINE
  FINANCE
}

enum DispenseRequestState {
  REQUESTED
  STARTED
  COMPLETED
  FAILED
}

model Customer {
  id                      String    @id @default(uuid())
  phone                   String?   @unique
  phoneVerifiedAt         DateTime?
  primaryIdentityProvider String?
  name                    String?
  telegramId              String?   @unique
  telegramUsername        String?
  email                   String?
  birthday                DateTime?
  vkProfile               String?
  status                  String    @default("active")
  trustedStatus           Boolean   @default(false)
  trustedStatusAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  clubAccount             ClubAccount?
  identities              CustomerIdentity[]
  authSessions            AuthSession[]
  bonusAccount            BonusAccount?
  orders                  Order[]
  consents                CustomerConsent[]
  bonusTransactions       BonusTransaction[]
  referralsMade           Referral[]                       @relation("Referrer")
  referredBy              Referral[]                       @relation("Referred")
  photoChallenges         PhotoChallenge[]
  birthdayRewards         BirthdayReward[]
  payments                Payment[]
  segmentAssignments      CustomerSegment[]
  crmProfile              CrmCustomerProfile?
  notificationDeliveries  CrmNotificationDelivery[]
  customerPreferences     CustomerPreference[]
  promotionParticipations CustomerPromotionParticipation[]
  gameActivities          CustomerGameActivity[]
  aiProfile               CustomerAiProfile?
  timelineEvents          CustomerTimelineEvent[]
  externalProfiles        CustomerExternalProfile[]
  channelSubscriptions    CustomerChannelSubscription[]
  organizationMemberships OrganizationMember[]
}

model CustomerPreference {
  id         String   @id @default(uuid())
  customerId String
  category   String
  key        String
  value      Json
  source     String
  confidence Float    @default(1)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category, key])
  @@index([customerId, updatedAt])
}

model CustomerPromotionParticipation {
  id            String    @id @default(uuid())
  customerId    String
  promotionCode String
  status        String    @default("ELIGIBLE")
  source        String
  metadata      Json?
  joinedAt      DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, promotionCode])
  @@index([customerId, status, joinedAt])
}

model CustomerGameActivity {
  id           String   @id @default(uuid())
  customerId   String
  gameCode     String
  activityType String
  status       String   @default("STARTED")
  score        Int?
  rewardType   String?
  rewardValue  Int?
  metadata     Json?
  occurredAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, occurredAt])
  @@index([gameCode, status])
}

model CustomerAiProfile {
  id              String    @id @default(uuid())
  customerId      String    @unique
  schemaVersion   Int       @default(1)
  status          String    @default("FOUNDATION_ONLY")
  featureSnapshot Json?
  summary         Json?
  modelReference  String?
  calculatedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerTimelineEvent {
  id               String   @id @default(uuid())
  customerId       String
  eventType        String
  category         String
  title            String
  description      String?
  sourceDomain     String
  sourceEntityType String?
  sourceEntityId   String?
  correlationId    String?
  metadata         Json?
  occurredAt       DateTime
  recordedAt       DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, sourceDomain, sourceEntityType, sourceEntityId, eventType])
  @@index([customerId, occurredAt])
  @@index([category, occurredAt])
}

model CustomerExternalProfile {
  id                 String    @id @default(uuid())
  customerId         String
  channelType        String
  externalUserId     String?
  username           String?
  profileUrl         String?
  displayName        String?
  avatarUrl          String?
  isVerified         Boolean   @default(false)
  verifiedAt         DateTime?
  verificationMethod String
  source             String
  lastCheckedAt      DateTime?
  status             String
  consentId          String?
  metadata           Json?
  actorId            String?
  auditReason        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, channelType])
}

model CustomerChannelSubscription {
  id                 String    @id @default(uuid())
  customerId         String
  channelType        String
  targetType         String
  targetExternalId   String?
  targetName         String?
  isSubscribed       Boolean   @default(false)
  subscribedAt       DateTime?
  unsubscribedAt     DateTime?
  lastCheckedAt      DateTime?
  source             String
  verificationStatus String
  consentId          String?
  metadata           Json?
  actorId            String?
  auditReason        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, channelType])
}

model CrmCustomerProfile {
  id                  String   @id @default(uuid())
  customerId          String   @unique
  managerId           String?
  serviceNote         String?
  preferredChannel    String   @default("TELEGRAM")
  communicationStatus String   @default("ALLOWED")
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model CrmCampaign {
  id              String    @id @default(uuid())
  code            String    @unique
  name            String
  description     String?
  status          String    @default("DRAFT")
  segmentId       String?
  channel         String
  messageTemplate String
  startsAt        DateTime?
  endsAt          DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deliveries CrmNotificationDelivery[]

  @@index([status, startsAt])
  @@index([segmentId])
}

model CrmNotificationDelivery {
  id             String    @id @default(uuid())
  customerId     String
  campaignId     String?
  channel        String
  subject        String?
  body           String
  status         String    @default("QUEUED")
  providerId     String?
  failureReason  String?
  idempotencyKey String?   @unique
  correlationId  String?
  createdBy      String
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  customer Customer     @relation(fields: [customerId], references: [id])
  campaign CrmCampaign? @relation(fields: [campaignId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

enum OperatorRole {
  OPERATOR
  ADMIN
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

enum MaintenanceTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TestRunStatus {
  PASSED
  FAILED
}

enum InventoryMovementType {
  CONSUMPTION
  REPLENISHMENT
  ADJUSTMENT
}

enum InventoryItemType {
  CUP
  ICE_CREAM_MIX
  TOPPING
}

enum InventoryRuntimeItemCategory {
  INGREDIENT
  CONSUMABLE
  SERVICE_MATERIAL
}

enum InventoryRuntimeLocationType {
  WAREHOUSE
  MACHINE
}

enum InventoryRuntimeMovementType {
  RECEIPT
  CONSUMPTION
  TEST_CONSUMPTION
  MAINTENANCE
  INVENTORY_COUNT
  ADJUSTMENT
}

enum InventoryRuntimeReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum MaintenancePlanType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceSessionStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum MaintenanceCheckStatus {
  PENDING
  PASSED
  FAILED
  NOT_APPLICABLE
}

enum SegmentType {
  MANUAL
  SYSTEM
}

enum SegmentStatus {
  ACTIVE
  INACTIVE
}

model Segment {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  type        SegmentType
  status      SegmentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rules       SegmentRule[]
  assignments CustomerSegment[]

  @@index([status, type])
}

model SegmentRule {
  id        String   @id @default(uuid())
  segmentId String
  ruleType  String
  criteria  Json
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([segmentId, priority])
}

model CustomerSegment {
  id           String    @id @default(uuid())
  customerId   String
  segmentId    String
  source       String
  reason       String?
  assignedBy   String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  segment  Segment  @relation(fields: [segmentId], references: [id])

  @@index([customerId, unassignedAt, assignedAt])
  @@index([segmentId, unassignedAt, assignedAt])
}

model CustomerIdentity {
  id                  String    @id @default(uuid())
  customerId          String
  provider            String
  externalSubjectHash String
  externalUsername    String?
  displayName         String?
  verificationMethod  String
  status              String    @default("active")
  sourceChannel       String?
  verifiedAt          DateTime  @default(now())
  linkedAt            DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([provider, externalSubjectHash])
}

model AuthSession {
  id              String    @id @default(uuid())
  subjectType     String
  customerId      String
  authMethod      String
  consumerType    String
  accessTokenHash String    @unique
  tokenType       String    @default("Bearer")
  correlationId   String?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model IdempotencyRecord {
  id              String    @id @default(uuid())
  scope           String
  key             String
  actorContext    Json?
  semanticHash    String
  status          String
  resultReference String?
  correlationId   String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime?

  @@unique([scope, key])
}

model AuditEvent {
  id            String   @id @default(uuid())
  eventType     String
  subjectType   String?
  subjectId     String?
  targetType    String?
  targetId      String?
  action        String
  decision      String
  reasonCode    String?
  authMethod    String?
  sourceChannel String?
  correlationId String?
  metadata      Json?
  occurredAt    DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([correlationId])
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentType  String
  version       String
  title         String
  filePath      String
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  consents CustomerConsent[]

  @@unique([documentType, version])
}

enum ConsentType {
  PERSONAL_DATA
  MARKETING
  ADVERTISING
  PARTNER_OFFERS
  PHOTO_USAGE
}

enum ConsentSourceChannel {
  TELEGRAM
  MINI_APP
  MACHINE
  WEBSITE
}

model CustomerConsent {
  id            String               @id @default(uuid())
  customerId    String
  documentId    String
  consentType   ConsentType
  isGranted     Boolean              @default(true)
  consentedAt   DateTime             @default(now())
  revokedAt     DateTime?
  sourceChannel ConsentSourceChannel
  ipAddress     String?
  decisionId    String
  correlationId String?

  customer Customer        @relation(fields: [customerId], references: [id])
  document DocumentVersion @relation(fields: [documentId], references: [id])

  @@unique([customerId, decisionId])
  @@index([customerId, consentType, consentedAt])
}

model ClubAccount {
  id                  String    @id @default(uuid())
  customerId          String    @unique
  status              String    @default("active")
  currency            String    @default("RUB")
  balanceRub          Float     @default(0)
  availableBalanceRub Float     @default(0)
  reservedBalanceRub  Float     @default(0)
  clubActive          Boolean   @default(false)
  activatedAt         DateTime?
  lastTopupAt         DateTime?
  lastTransactionId   String?
  projectionVersion   Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer     Customer                 @relation(fields: [customerId], references: [id])
  topups       ClubTopup[]
  transactions ClubAccountTransaction[]
}

model ClubAccountTransaction {
  id                       String   @id @default(uuid())
  clubAccountId            String
  customerId               String
  transactionType          String
  direction                String
  amountRub                Float
  currency                 String   @default("RUB")
  availableDeltaRub        Float
  reservedDeltaRub         Float    @default(0)
  availableBalanceAfterRub Float
  reservedBalanceAfterRub  Float
  balanceAfterRub          Float
  status                   String   @default("posted")
  reason                   String
  referenceEntityType      String?
  referenceEntityId        String?
  sourceDomain             String?
  sourceId                 String?
  idempotencyKey           String?
  actorType                String   @default("customer")
  actorId                  String?
  correlationId            String?
  createdAt                DateTime @default(now())
  postedAt                 DateTime @default(now())

  clubAccount ClubAccount @relation(fields: [clubAccountId], references: [id])

  @@unique([clubAccountId, idempotencyKey])
  @@index([customerId, postedAt])
  @@index([clubAccountId, postedAt])
}

model ClubTopup {
  id              String    @id @default(uuid())
  clubAccountId   String
  customerId      String
  amountRub       Float
  paymentProvider String
  paymentStatus   String    @default("pending")
  paymentId       String?
  channel         String
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  clubAccount ClubAccount @relation(fields: [clubAccountId], references: [id])
  payment     Payment?
}

model BonusAccount {
  id           String   @id @default(uuid())
  customerId   String   @unique
  balanceBonus Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model BonusTransaction {
  id                  String   @id @default(uuid())
  customerId          String
  orderId             String?
  referralId          String?
  type                String
  direction           String   @default("credit")
  amountBonus         Int
  source              String
  reason              String?
  referenceEntityType String?
  referenceEntityId   String?
  balanceAfterBonus   Int?
  comment             String?
  createdAt           DateTime @default(now())
  postedAt            DateTime @default(now())

  customer Customer  @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  referral Referral? @relation(fields: [referralId], references: [id])
}

model Machine {
  id          String        @id @default(uuid())
  machineCode String        @unique
  name        String
  location    String?
  status      MachineStatus @default(OFFLINE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders                       Order[]
  inventory                    MachineInventory[]
  dispenseRequests             DispenseRequest[]
  maintenanceTasks             MaintenanceTask[]
  serviceLogs                  ServiceLog[]
  testRuns                     TestRun[]
  inventoryMovements           InventoryMovement[]
  settings                     MachineSetting[]
  simCard                      MachineSimCard?
  mobilePlan                   MachineMobilePlan?
  connectivitySnapshots        MachineConnectivitySnapshot[]
  connectivityEvents           MachineConnectivityEvent[]
  organizationAssignments      OrganizationMachineAssignment[]
  organizationResponsibilities OrganizationResponsibility[]
}

model Organization {
  id                   String             @id @default(uuid())
  fullName             String
  shortName            String
  organizationType     String
  inn                  String?
  kpp                  String?
  ogrn                 String?
  legalAddress         String?
  actualAddress        String?
  phone                String?
  email                String?
  website              String?
  status               OrganizationStatus @default(ACTIVE)
  foundedAt            DateTime?
  cooperationStartedAt DateTime?
  note                 String?
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  units              OrganizationUnit[]
  members            OrganizationMember[]
  locations          OrganizationLocation[]
  machineAssignments OrganizationMachineAssignment[]
  responsibilities   OrganizationResponsibility[]
  roleAssignments    OrganizationRoleAssignment[]
  ownedMachines      OrganizationMachineAssignment[] @relation("OrganizationMachineOwner")
  operatedMachines   OrganizationMachineAssignment[] @relation("OrganizationMachineOperator")

  @@unique([inn, kpp])
  @@index([status, shortName])
  @@index([createdAt])
}

model OrganizationUnit {
  id             String    @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  code           String
  description    String?
  status         String    @default("ACTIVE")
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent           OrganizationUnit?            @relation("OrganizationUnitHierarchy", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children         OrganizationUnit[]           @relation("OrganizationUnitHierarchy")
  members          OrganizationMember[]
  locations        OrganizationLocation[]
  responsibilities OrganizationResponsibility[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, parentId, status])
}

model OrganizationMember {
  id                  String                   @id @default(uuid())
  organizationId      String
  unitId              String?
  platformUserId      String?
  fullName            String
  position            String
  phone               String?
  email               String?
  status              OrganizationMemberStatus @default(ACTIVE)
  employmentStartedAt DateTime?
  employmentEndedAt   DateTime?
  responsibilityZone  String?
  archivedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization         Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit                 OrganizationUnit?               @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  platformUser         Customer?                       @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  roleAssignments      OrganizationRoleAssignment[]
  responsibilities     OrganizationResponsibility[]
  responsibleLocations OrganizationLocation[]          @relation("OrganizationLocationResponsible")
  machineAssignments   OrganizationMachineAssignment[] @relation("OrganizationMachineResponsible")
  serviceAssignments   OrganizationMachineAssignment[] @relation("OrganizationMachineService")

  @@unique([organizationId, platformUserId])
  @@unique([id, organizationId])
  @@index([organizationId, unitId, status])
  @@index([platformUserId])
}

model OrganizationRoleAssignment {
  id             String               @id @default(uuid())
  organizationId String
  memberId       String
  role           OrganizationRoleType
  grantedBy      String
  grantedAt      DateTime             @default(now())
  revokedAt      DateTime?
  note           String?

  member       OrganizationMember @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, memberId, role, revokedAt])
  @@index([organizationId, role, revokedAt])
}

model OrganizationLocation {
  id                  String                     @id @default(uuid())
  organizationId      String
  responsibleUnitId   String?
  responsibleMemberId String?
  name                String
  address             String
  latitude            Decimal?                   @db.Decimal(9, 6)
  longitude           Decimal?                   @db.Decimal(9, 6)
  openingHours        Json?
  status              OrganizationLocationStatus @default(ACTIVE)
  archivedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  responsibleUnit    OrganizationUnit?               @relation(fields: [responsibleUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  responsibleMember  OrganizationMember?             @relation("OrganizationLocationResponsible", fields: [responsibleMemberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  machineAssignments OrganizationMachineAssignment[]
  responsibilities   OrganizationResponsibility[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, latitude, longitude])
}

model OrganizationMachineAssignment {
  id                     String    @id @default(uuid())
  organizationId         String
  machineId              String
  locationId             String?
  ownerOrganizationId    String
  operatorOrganizationId String
  responsibleMemberId    String?
  serviceSpecialistId    String?
  assignedAt             DateTime  @default(now())
  unassignedAt           DateTime?
  assignedBy             String
  note                   String?

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerOrganization    Organization          @relation("OrganizationMachineOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  operatorOrganization Organization          @relation("OrganizationMachineOperator", fields: [operatorOrganizationId], references: [id], onDelete: Restrict)
  machine              Machine               @relation(fields: [machineId], references: [id], onDelete: Restrict)
  location             OrganizationLocation? @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  responsibleMember    OrganizationMember?   @relation("OrganizationMachineResponsible", fields: [responsibleMemberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  serviceSpecialist    OrganizationMember?   @relation("OrganizationMachineService", fields: [serviceSpecialistId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, unassignedAt])
  @@index([machineId, unassignedAt])
  @@index([locationId, unassignedAt])
}

model OrganizationResponsibility {
  id             String                          @id @default(uuid())
  organizationId String
  memberId       String
  scope          OrganizationResponsibilityScope
  unitId         String?
  locationId     String?
  machineId      String?
  description    String?
  assignedBy     String
  assignedAt     DateTime                        @default(now())
  revokedAt      DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       OrganizationMember    @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  unit         OrganizationUnit?     @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  location     OrganizationLocation? @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  machine      Machine?              @relation(fields: [machineId], references: [id], onDelete: Restrict)

  @@index([organizationId, scope, revokedAt])
  @@index([memberId, revokedAt])
  @@index([machineId, revokedAt])
}

model MachineSimCard {
  id                 String    @id @default(uuid())
  machineId          String    @unique
  phoneNumber        String?
  carrierName        String?
  carrierCode        String?
  iccid              String?
  imsi               String?
  activatedAt        DateTime?
  deactivatedAt      DateTime?
  lastCheckedAt      DateTime?
  source             String
  verificationStatus String
  metadata           Json?
  actorId            String?
  auditReason        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  machine            Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model MachineMobilePlan {
  id                      String    @id @default(uuid())
  machineId               String    @unique
  tariffName              String?
  tariffStatus            String
  monthlyFee              Decimal?  @db.Decimal(12, 2)
  currentBalance          Decimal?  @db.Decimal(12, 2)
  currency                String    @default("RUB")
  trafficLimitMb          Int?
  trafficRemainingMb      Int?
  nextChargeAt            DateTime?
  autoTopUpEnabled        Boolean   @default(false)
  minimumBalanceThreshold Decimal?  @db.Decimal(12, 2)
  lastCheckedAt           DateTime?
  source                  String
  verificationStatus      String
  metadata                Json?
  actorId                 String?
  auditReason             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  machine                 Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model MachineConnectivitySnapshot {
