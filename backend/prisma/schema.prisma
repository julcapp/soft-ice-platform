generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  DISPENSING
  COMPLETED
  FAILED
  CANCELLED
  CANCELLED_BY_CUSTOMER
}

enum MachineStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  BLOCKED
}

enum OrganizationMemberStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganizationLocationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRoleType {
  OWNER
  ADMINISTRATOR
  MANAGER
  OPERATOR
  SERVICE_SPECIALIST
  MACHINE_RESPONSIBLE
  LOCATION_RESPONSIBLE
  FINANCIALLY_RESPONSIBLE
}

enum OrganizationResponsibilityScope {
  ORGANIZATION
  UNIT
  LOCATION
  MACHINE
  FINANCE
}

enum DispenseRequestState {
  REQUESTED
  STARTED
  COMPLETED
  FAILED
}

model Customer {
  id                      String    @id @default(uuid())
  phone                   String?   @unique
  phoneVerifiedAt         DateTime?
  primaryIdentityProvider String?
  name                    String?
  telegramId              String?   @unique
  telegramUsername        String?
  email                   String?
  birthday                DateTime?
  vkProfile               String?
  status                  String    @default("active")
  trustedStatus           Boolean   @default(false)
  trustedStatusAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  clubAccount                 ClubAccount?
  identities                  CustomerIdentity[]
  authSessions                AuthSession[]
  bonusAccount                BonusAccount?
  orders                      Order[]
  consents                    CustomerConsent[]
  bonusTransactions           BonusTransaction[]
  referralsMade               Referral[]                       @relation("Referrer")
  referredBy                  Referral[]                       @relation("Referred")
  photoChallenges             PhotoChallenge[]
  birthdayRewards             BirthdayReward[]
  payments                    Payment[]
  segmentAssignments          CustomerSegment[]
  crmProfile                  CrmCustomerProfile?
  notificationDeliveries      CrmNotificationDelivery[]
  customerPreferences         CustomerPreference[]
  promotionParticipations     CustomerPromotionParticipation[]
  gameActivities              CustomerGameActivity[]
  aiProfile                   CustomerAiProfile?
  timelineEvents              CustomerTimelineEvent[]
  externalProfiles            CustomerExternalProfile[]
  channelSubscriptions        CustomerChannelSubscription[]
  organizationMemberships     OrganizationMember[]
  privateChannelSubscriptions PrivateChannelSubscription[]
  privateChannelPayments      PrivateChannelPayment[]
}

model CustomerPreference {
  id         String   @id @default(uuid())
  customerId String
  category   String
  key        String
  value      Json
  source     String
  confidence Float    @default(1)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category, key])
  @@index([customerId, updatedAt])
}

model CustomerPromotionParticipation {
  id            String    @id @default(uuid())
  customerId    String
  promotionCode String
  status        String    @default("ELIGIBLE")
  source        String
  metadata      Json?
  joinedAt      DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, joinedAt])
  @@index([promotionCode, status])
}

model CustomerGameActivity {
  id           String   @id @default(uuid())
  customerId   String
  gameCode     String
  activityType String
  status       String
  score        Int?
  metadata     Json?
  occurredAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, occurredAt])
  @@index([gameCode, status])
}

model CustomerAiProfile {
  id              String   @id @default(uuid())
  customerId      String   @unique
  schemaVersion   Int      @default(1)
  status          String   @default("FOUNDATION_ONLY")
  featureSnapshot Json?
  summary         Json?
  modelReference  String?
  calculatedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerTimelineEvent {
  id               String   @id @default(uuid())
  customerId       String
  eventType        String
  category         String
  title            String
  description      String?
  sourceDomain     String
  sourceEntityType String?
  sourceEntityId   String?
  correlationId    String?
  metadata         Json?
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([correlationId])
}

model CustomerExternalProfile {
  id             String   @id @default(uuid())
  customerId     String
  channelType    String
  externalUserId String?
  username       String?
  displayName    String?
  profileUrl     String?
  source         String
  isVerified     Boolean  @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, channelType])
  @@index([channelType, externalUserId])
}

model CustomerChannelSubscription {
  id               String    @id @default(uuid())
  customerId       String
  channelType      String
  targetType       String
  targetExternalId String?
  targetName       String?
  isSubscribed     Boolean   @default(false)
  subscribedAt     DateTime?
  unsubscribedAt   DateTime?
  lastCheckedAt    DateTime?
  source           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, channelType, isSubscribed])
  @@index([channelType, targetExternalId])
}

model PrivateChannelPlan {
  id                String   @id
  code              String   @unique
  name              String
  channelType       String
  targetExternalId  String?
  priceRub          Decimal  @db.Decimal(12, 2)
  billingPeriodDays Int
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions PrivateChannelSubscription[]
}

model PrivateChannelSubscription {
  id                         String    @id @default(uuid())
  customerId                 String
  planId                     String
  status                     String    @default("PENDING")
  currentPeriodStart         DateTime?
  currentPeriodEnd           DateTime?
  recurringEnabled           Boolean   @default(false)
  recurringConsentAt         DateTime?
  recurringConsentVersion    String?
  providerPaymentMethodRef   String?
  cancelAtPeriodEnd          Boolean   @default(false)
  cancelledAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan     PrivateChannelPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments PrivateChannelPayment[]

  @@index([customerId, status])
  @@index([currentPeriodEnd])
}

model PrivateChannelPayment {
  id                String    @id @default(uuid())
  subscriptionId    String
  customerId        String
  provider          String
  providerPaymentId String?
  paymentKind       String
  amountRub         Decimal   @db.Decimal(12, 2)
  status            String
  periodStart       DateTime?
  periodEnd         DateTime?
  idempotencyKey    String?   @unique
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())

  subscription PrivateChannelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer     Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@index([paidAt])
}

model ClubAccount {
  id                   String    @id @default(uuid())
  customerId           String    @unique
  status               String    @default("active")
  clubActive           Boolean   @default(false)
  activatedAt          DateTime?
  currency             String    @default("RUB")
  availableBalanceRub  Float     @default(0)
  reservedBalanceRub   Float     @default(0)
  totalTopupRub        Float     @default(0)
  totalSpentRub        Float     @default(0)
  lastTopupAt          DateTime?
  lastPurchaseAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer     Customer                 @relation(fields: [customerId], references: [id])
  transactions ClubAccountTransaction[]
  topups        ClubTopup[]
}

model ClubAccountTransaction {
  id             String   @id @default(uuid())
  clubAccountId  String
  customerId     String
  transactionType String
  direction      String
  amountRub      Float
  balanceAfterRub Float
  reason         String
  referenceType  String?
  referenceId    String?
  status         String   @default("posted")
  idempotencyKey String?
  correlationId  String?
  postedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  clubAccount ClubAccount @relation(fields: [clubAccountId], references: [id])

  @@unique([clubAccountId, idempotencyKey])
  @@index([customerId, postedAt])
  @@index([clubAccountId, postedAt])
}

model ClubTopup {
  id              String    @id @default(uuid())
  clubAccountId   String
  customerId      String
  amountRub       Float
  paymentProvider String
  paymentStatus   String    @default("pending")
  paymentId       String?
  channel         String
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  clubAccount ClubAccount @relation(fields: [clubAccountId], references: [id])
  payment     Payment?
}

model BonusAccount {
  id           String   @id @default(uuid())
  customerId   String   @unique
  balanceBonus Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model BonusTransaction {
  id                  String   @id @default(uuid())
  customerId          String
  orderId             String?
  referralId          String?
  type                String
  direction           String   @default("credit")
  amountBonus         Int
  source              String
  reason              String?
  referenceEntityType String?
  referenceEntityId   String?
  balanceAfterBonus   Int?
  comment             String?
  createdAt           DateTime @default(now())
  postedAt            DateTime @default(now())

  customer Customer  @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  referral Referral? @relation(fields: [referralId], references: [id])
}

model Machine {
  id          String        @id @default(uuid())
  machineCode String        @unique
  name        String
  location    String?
  status      MachineStatus @default(OFFLINE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders                       Order[]
  inventory                    MachineInventory[]
  dispenseRequests             DispenseRequest[]
  maintenanceTasks             MaintenanceTask[]
  serviceLogs                  ServiceLog[]
  testRuns                     TestRun[]
  inventoryMovements           InventoryMovement[]
  settings                     MachineSetting[]
  simCard                      MachineSimCard?
  mobilePlan                   MachineMobilePlan?
  connectivitySnapshots        MachineConnectivitySnapshot[]
  connectivityEvents           MachineConnectivityEvent[]
  organizationAssignments      OrganizationMachineAssignment[]
  organizationResponsibilities OrganizationResponsibility[]
}

model Organization {
  id                   String             @id @default(uuid())
  fullName             String
  shortName            String
  organizationType     String
  inn                  String?
  kpp                  String?
  ogrn                  String?
  taxMode               String?
  legalAddress          String?
  actualAddress         String?
  email                 String?
  phone                 String?
  website               String?
  status                OrganizationStatus @default(ACTIVE)
  parentOrganizationId  String?
  settings              Json?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  parent            Organization?                @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: Restrict)
  children          Organization[]               @relation("OrganizationHierarchy")
  units             OrganizationUnit[]
  members           OrganizationMember[]
  roles             OrganizationRole[]
  locations         OrganizationLocation[]
  machineAssignments OrganizationMachineAssignment[]
  responsibilities  OrganizationResponsibility[]
  auditEvents       OrganizationAuditEvent[]

  @@index([status])
  @@index([parentOrganizationId])
}

model OrganizationUnit {
  id             String   @id @default(uuid())
  organizationId String
  parentUnitId   String?
  code           String
  name           String
  unitType       String?
  status         String   @default("ACTIVE")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       OrganizationUnit?   @relation("OrganizationUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: Restrict)
  children     OrganizationUnit[]  @relation("OrganizationUnitHierarchy")
  members      OrganizationMember[]
  locations    OrganizationLocation[]
  responsibilities OrganizationResponsibility[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([parentUnitId])
}

model OrganizationMember {
  id             String                   @id @default(uuid())
  organizationId String
  customerId     String?
  unitId         String?
  displayName    String
  email          String?
  phone          String?
  positionTitle  String?
  memberType     String
  status         OrganizationMemberStatus @default(ACTIVE)
  externalRef    String?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unit         OrganizationUnit? @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  roleAssignments OrganizationRoleAssignment[]
  responsibilities OrganizationResponsibility[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([unitId])
}

model OrganizationRole {
  id             String               @id @default(uuid())
  organizationId String
  code           String
  name           String
  roleType       OrganizationRoleType
  permissions    Json
  isSystem       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  OrganizationRoleAssignment[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, roleType])
}

model OrganizationRoleAssignment {
  id             String    @id @default(uuid())
  organizationId String
  memberId       String
  roleId         String
  assignedBy     String?
  assignedAt     DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       OrganizationMember  @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  role         OrganizationRole    @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, revokedAt])
  @@index([memberId, revokedAt])
  @@index([roleId, revokedAt])
}

model OrganizationLocation {
  id             String                     @id @default(uuid())
  organizationId String
  unitId         String?
  code           String
  name           String
  locationType   String
  address        String?
  latitude       Decimal?                   @db.Decimal(9, 6)
  longitude      Decimal?                   @db.Decimal(9, 6)
  status         OrganizationLocationStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit         OrganizationUnit?  @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  machineAssignments OrganizationMachineAssignment[]
  responsibilities OrganizationResponsibility[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([unitId])
}

model OrganizationMachineAssignment {
  id             String    @id @default(uuid())
  organizationId String
  machineId      String
  locationId     String?
  assignedBy     String?
  assignedAt     DateTime  @default(now())
  unassignedAt   DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  machine      Machine               @relation(fields: [machineId], references: [id], onDelete: Restrict)
  location     OrganizationLocation? @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, unassignedAt])
  @@index([machineId, unassignedAt])
  @@index([locationId, unassignedAt])
}

model OrganizationResponsibility {
  id             String                          @id @default(uuid())
  organizationId String
  memberId       String
  scope          OrganizationResponsibilityScope
  unitId         String?
  locationId     String?
  machineId      String?
  assignedBy     String?
  assignedAt     DateTime                        @default(now())
  revokedAt      DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       OrganizationMember    @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  unit         OrganizationUnit?     @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  location     OrganizationLocation? @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  machine      Machine?              @relation(fields: [machineId], references: [id], onDelete: Restrict)

  @@index([organizationId, scope, revokedAt])
  @@index([memberId, revokedAt])
  @@index([machineId, revokedAt])
}

model OrganizationAuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  eventType      String
  actorId        String?
  targetType     String
  targetId       String
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([correlationId])
}

model Operator {
  id        String         @id @default(uuid())
  name      String
  phone     String?        @unique
  role      OperatorRole   @default(OPERATOR)
  status    OperatorStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  assignments         OperatorMachineAssignment[]
  maintenanceTasks    MaintenanceTask[]
  serviceLogs         ServiceLog[]
  testRuns            TestRun[]
  workspaceAssignments OperatorWorkspaceAssignment[]
  workspaceActions    OperatorWorkspaceAction[]
  maintenanceSessions MaintenanceSession[]
}

model OperatorMachineAssignment {
  id         String   @id @default(uuid())
  operatorId String
  machineId  String
  assignedAt DateTime @default(now())
  revokedAt  DateTime?

  operator Operator @relation(fields: [operatorId], references: [id])
  machine  Machine  @relation(fields: [machineId], references: [id])

  @@unique([operatorId, machineId])
}

model MaintenanceTask {
  id             String                @id @default(uuid())
  machineId      String
  assignedToId   String?
  taskType       String
  description    String?
  dueAt          DateTime?
  status         MaintenanceTaskStatus @default(OPEN)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  machine    Machine   @relation(fields: [machineId], references: [id])
  assignedTo Operator? @relation(fields: [assignedToId], references: [id])
}

model ServiceLog {
  id              String           @id @default(uuid())
  machineId       String
  operatorId      String
  maintenanceTaskId String?
  status          ServiceLogStatus @default(DRAFT)
  notes           String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  machine         Machine          @relation(fields: [machineId], references: [id])
  operator        Operator         @relation(fields: [operatorId], references: [id])
  maintenanceTask MaintenanceTask? @relation(fields: [maintenanceTaskId], references: [id])
}

model TestRun {
  id           String        @id @default(uuid())
  machineId    String
  operatorId   String
  testType     String
  status       TestRunStatus
  details      Json?
  createdAt    DateTime      @default(now())

  machine  Machine  @relation(fields: [machineId], references: [id])
  operator Operator @relation(fields: [operatorId], references: [id])
}

model MachineInventory {
  id        String            @id @default(uuid())
  machineId String
  itemType  InventoryItemType
  itemCode  String
  quantity  Float             @default(0)
  unit      String
  updatedAt DateTime          @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([machineId, itemType, itemCode])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  machineId    String
  movementType InventoryMovementType
  itemType     InventoryItemType
  itemCode     String
  quantity     Float
  unit         String
  sourceType   String
  sourceId     String?
  notes        String?
  createdAt    DateTime              @default(now())

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId, createdAt])
}

model MachineSetting {
  id        String   @id @default(uuid())
  machineId String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([machineId, key])
}

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  basePrice   Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id                     String      @id @default(uuid())
  customerId             String
  machineId              String?
  productId              String?
  status                 OrderStatus @default(CREATED)
  amount                 Float
  amountPaidRub          Float?
  bonusEarned            Int         @default(0)
  bonusRedeemed          Int         @default(0)
  selectedTopping        String?
  selectedAdditive       String?
  tasteCode              String?
  paymentProvider        String?
  paymentMethod          String?
  paymentId              String?
  prepaid                Boolean     @default(false)
  expiresAt              DateTime?
  activePickupCodeHash   String?
  pickupCodeExpiresAt    DateTime?
  pickupCodeIssuedAt     DateTime?
  pickedUpAt             DateTime?
  cancelReason           String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  paidAt                 DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  machine  Machine? @relation(fields: [machineId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])
  payment  Payment?
  dispenseRequest DispenseRequest?
  bonusTransactions BonusTransaction[]

  @@index([customerId, createdAt])
  @@index([machineId, createdAt])
  @@index([status, expiresAt])
}

model Payment {
  id              String    @id @default(uuid())
  customerId      String
  orderId         String?   @unique
  clubTopupId     String?   @unique
  provider        String
  method          String
  status          String
  amountRub       Float
  currency        String    @default("RUB")
  providerPaymentId String?
  providerPaymentMethodRef String?
  description     String?
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?

  customer  Customer   @relation(fields: [customerId], references: [id])
  order     Order?      @relation(fields: [orderId], references: [id])
  clubTopup ClubTopup?  @relation(fields: [clubTopupId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Referral {
  id                 String    @id @default(uuid())
  referrerCustomerId String
  referredCustomerId String?   @unique
  referralCode       String
  status             String    @default("registered")
  firstPurchaseAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  referrer Customer  @relation("Referrer", fields: [referrerCustomerId], references: [id])
  referred Customer? @relation("Referred", fields: [referredCustomerId], references: [id])
  bonusTransactions BonusTransaction[]

  @@index([referrerCustomerId, createdAt])
  @@index([referralCode])
}

model BirthdayReward {
  id         String   @id @default(uuid())
  customerId String
  year       Int
  issuedAt   DateTime @default(now())
  usedAt     DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, year])
}

model PhotoChallenge {
  id                   String    @id @default(uuid())
  customerId           String
  challengeCodeHash    String?
  challengeCodeExpiresAt DateTime?
  challengeCodeIssuedAt DateTime?
  challengeCodeConsumedAt DateTime?
  status               String    @default("issued")
  bonusAmount          Int       @default(30)
  sourceStorageKey     String?
  sourceMimeType       String?
  sourceSizeBytes      Int?
  submittedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer          Customer                 @relation(fields: [customerId], references: [id])
  verifications     PhotoVerificationRecord[]
  fingerprints      PhotoFingerprint[]
  publications      PhotoPublication[]
  sourceFile        PhotoSourceFile?
  moderationEvents  PhotoModerationEvent[]

  @@index([customerId, status])
  @@index([status, createdAt])
}

model PhotoVerificationRecord {
  id                String   @id @default(uuid())
  photoChallengeId  String
  provider          String
  modelVersion      String?
  decision          String
  confidence        Float
  reasons           Json?
  evidence          Json?
  fraudScore        Float?
  createdAt         DateTime @default(now())

