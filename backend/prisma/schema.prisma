model InventoryLocation {
  id             String                       @id
  organizationId String
  machineId      String?
  locationType   InventoryRuntimeLocationType
  name           String
  isActive       Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  stockItems    InventoryStockItem[]
  movements     InventoryRuntimeMovement[]
  reservations  InventoryReservation[]

  @@index([organizationId, locationType])
  @@index([machineId])
}

model InventoryStockItem {
  id             String                       @id
  locationId     String
  sku            String
  name           String
  category       InventoryRuntimeItemCategory
  unit           String
  quantity       Int                          @default(0)
  reserved       Int                          @default(0)
  minimumLevel   Int                          @default(0)
  isActive       Boolean                      @default(true)
  version        Int                          @default(0)
