  createdAt      DateTime                     @default(now())

  location InventoryLocation @relation(fields: [locationId], references: [id])

  @@index([organizationId, occurredAt])
  @@index([locationId, occurredAt])
  @@index([operationType, operationId])
}

model InventoryReservation {
  id             String                            @id
  organizationId String
  locationId     String
  machineId      String?
  operationType  InventoryOperationType
  operationId    String
  status         InventoryRuntimeReservationStatus @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt

  location InventoryLocation @relation(fields: [locationId], references: [id])
  items    InventoryReservationItem[]

  @@unique([operationType, operationId])
  @@index([organizationId, status, expiresAt])
  @@index([locationId, status])
