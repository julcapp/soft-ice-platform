model Segment {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  type        SegmentType
  status      SegmentStatus @default(ACTIVE)
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rules       SegmentRule[]
  assignments CustomerSegment[]
}

model SegmentRule {
  id        String   @id @default(uuid())
  segmentId String
  metric    String
  operator  String
  value     Json
  priority  Int      @default(0)
