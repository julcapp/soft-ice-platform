enum SaleFlowState {
  CREATED
  AWAITING_PAYMENT
  PAID
  FULFILLMENT_AUTHORIZED
  DISPENSING
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
  FULFILLMENT_FAILED
  REFUND_REQUIRED
}

enum SaleFlowRecoveryStatus {
  NONE
  SAFE_TO_RESUME
  NEEDS_RECONCILIATION
  RECOVERING
  RECOVERED
  MANUAL_REVIEW_REQUIRED
}

enum SaleFlowIdempotencyStatus {
  STARTED
  COMPLETED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  RETRY
  DEAD_LETTER
}

model SaleFlow {
  id                                String                 @id @default(uuid())
  flowId                            String                 @unique
  orderId                           String                 @unique
  customerId                        String
  machineId                         String
  organizationId                    String
  locationId                        String
  correlationId                     String                 @unique
  currentState                      SaleFlowState           @default(CREATED)
  paymentReference                  String?
  fulfillmentAuthorizationReference String?
  inventoryReservationReference     String?
  loyaltyOperationReference         String?
  refundRequirementReference        String?
  completionOperationId             String?                @unique
  startedAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt
  completedAt                       DateTime?
  expiresAt                         DateTime?
  retentionUntil                    DateTime?
  version                           Int                     @default(0)
  lastProcessedEventId              String?
  lastErrorCode                     String?
  lastErrorAt                       DateTime?
  recoveryStatus                    SaleFlowRecoveryStatus @default(NONE)
  metadata                          Json?
  idempotencyKeys                   SaleFlowIdempotencyKey[]
  outboxEvents                      TransactionalOutboxEvent[]

  @@index([orderId])
  @@index([correlationId])
  @@index([currentState])
  @@index([recoveryStatus])
  @@index([machineId])
  @@index([customerId])
  @@index([organizationId])
  @@index([updatedAt])
}

model TransactionalOutboxEvent {
  id             String            @id @default(uuid())
  eventId        String            @unique
  eventType      String
  eventVersion   Int               @default(1)
  aggregateType  String
  aggregateId    String
  organizationId String
  machineId      String?
  saleFlowId     String?
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attemptCount   Int               @default(0)
  maxAttempts    Int               @default(5)
  availableAt    DateTime          @default(now())
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lockedAt       DateTime?
  lockedBy       String?
  publishedAt    DateTime?
  lastError      String?
  correlationId  String?
  causationId    String?
  idempotencyKey String            @unique
  saleFlow       SaleFlow?         @relation(fields: [saleFlowId], references: [flowId], onDelete: Restrict)

  @@index([status, availableAt, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([machineId, status, createdAt])
  @@index([eventType, createdAt])
  @@index([saleFlowId, createdAt])
  @@index([lockedAt])
}

model SaleFlowIdempotencyKey {
  id              String                       @id @default(uuid())
  flowId          String
  key             String                       @unique
  operationType   String
  source          String
  externalEventId String?
  requestHash     String
  status          SaleFlowIdempotencyStatus    @default(STARTED)
  resultReference String?
  createdAt       DateTime                     @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?
  flow            SaleFlow                     @relation(fields: [flowId], references: [flowId], onDelete: Restrict)

  @@index([flowId])
  @@index([externalEventId])
  @@index([operationType])
  @@index([expiresAt])
}

model EventRecord {
  id                      String    @id @default(uuid())
  tenantId                String
  organizationId          String?
  eventId                 String    @unique
  eventCode               String
  eventVersion            Int
  category                String
  severity                String
  sourceDomain            String
  sourceService           String?
  sourceEventId           String?
  subjectType             String
  subjectId               String
  subjectDisplayName      String?
  actorType               String?
  actorId                 String?
  actorDisplayName        String?
  machineId               String?
  customerId              String?
  orderId                 String?
  paymentId               String?
  maintenanceRequestId    String?
  inventoryOperationId    String?
  cameraId                String?
  videoIncidentId         String?
  correlationId           String?
  causationId             String?
  traceId                 String?
  title                   String
  summary                 String
  occurredAt              DateTime
  receivedAt              DateTime
  recordedAt              DateTime
  acknowledgementRequired Boolean   @default(false)
  payload                 Json
  metadata                Json?
  retentionUntil          DateTime?
  retentionReason         String?
  legalHold               Boolean   @default(false)
  createdAt               DateTime  @default(now())

  @@unique([sourceDomain, sourceEventId, eventCode, eventVersion])
  @@index([tenantId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([eventCode, occurredAt])
  @@index([category, severity, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([machineId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([correlationId])
  @@index([retentionUntil])
  @@index([legalHold])
}

model EventTypeDefinition {
  id                      String  @id
  eventCode               String
  version                 Int
  titleTemplate           String
  summaryTemplate         String
  category                String
  defaultSeverity         String
  subjectType             String
  acknowledgementRequired Boolean @default(false)
  retentionDays           Int
  enabled                 Boolean @default(true)
  emissionStatus          String
  schemaReference         String?
  sourceDomain            String
  documentationReference  String?
  metadata                Json?

  @@unique([eventCode, version])
}

model EventRelation {
  id                String  @id @default(uuid())
  eventRecordId     String
  relationType      String
  targetType        String
  targetId          String
  targetDisplayName String?
  metadata          Json?

  @@index([eventRecordId, relationType])
  @@index([targetType, targetId])
}

model EventEvidenceReference {
  id               String    @id @default(uuid())
  eventRecordId    String
  evidenceType     String
  sourceType       String
  sourceId         String
  storageReference String?
  title            String
  description      String?
  checksum         String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  legalHold        Boolean   @default(false)
  metadata         Json?

  @@index([eventRecordId, createdAt])
}

model EventProcessingState {
  id              String    @id @default(uuid())
  eventRecordId   String    @unique
  status          String
  seenAt          DateTime?
  updatedAt       DateTime  @updatedAt
  updatedBy       String
  legalHold       Boolean   @default(false)
  legalHoldReason String?

  @@index([status])
}

model EventAcknowledgement {
  id             String   @id @default(uuid())
  eventRecordId  String
  userId         String
  acknowledgedAt DateTime @default(now())
  comment        String?
  resolutionCode String?
  metadata       Json?

  @@index([eventRecordId, acknowledgedAt])
}

model EventComment {
  id            String    @id @default(uuid())
  eventRecordId String
  authorId      String
  body          String
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  deletedAt     DateTime?

  @@index([eventRecordId, createdAt])
}

model EventTag {
  id            String   @id @default(uuid())
  eventRecordId String
  value         String
  authorId      String
  createdAt     DateTime @default(now())

  @@unique([eventRecordId, value])
}

model EventDeletionAudit {
  id              String   @id @default(uuid())
  eventId         String
  retentionReason String
  deletionResult  String
  deletionAuditId String?
  deletedAt       DateTime @default(now())
  metadata        Json?

  @@index([eventId, deletedAt])
}
