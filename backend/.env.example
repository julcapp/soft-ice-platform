NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL is the MVP backend database.
# Replace CHANGE_ME with an ephemeral local password; never commit the real value.
DATABASE_URL=postgresql://soft_ice_platform:CHANGE_ME@localhost:5432/soft_ice_platform?schema=public
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=5

# Telegram Mini App authentication.
# Use a real bot token only in a secure runtime environment, never in source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Telegram + MAX Bot Core. Disabled by default.
# Bot Core does NOT reuse TELEGRAM_BOT_TOKEN automatically.
# Use an isolated Telegram test bot token until production rollout is explicitly approved.
BOT_WEBHOOKS_ENABLED=false
BOT_MINI_APP_URL=https://app.utimoshi.ru
BOT_SMART_LINK_URL=https://go.utimoshi.ru/start
BOT_TELEGRAM_CHANNEL_URL=
BOT_MAX_CHANNEL_URL=
TELEGRAM_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET=
TELEGRAM_TEST_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
MAX_TEST_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru

# Platform infrastructure. Secrets are supplied by the deployment environment.
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
FEATURE_PAYMENTS_ENABLED=false
FEATURE_MACHINE_DISPATCH_ENABLED=false

# Local Docker Compose PostgreSQL settings.
POSTGRES_DB=soft_ice_platform
POSTGRES_USER=soft_ice_platform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
HUAXIN_MACHINE_ID=huaxin_default
HUAXIN_HEARTBEAT_INTERVAL_MS=15000
HUAXIN_HEARTBEAT_TIMEOUT_MS=45000
HUAXIN_COMMAND_TIMEOUT_MS=5000
HUAXIN_RECONNECT_BASE_DELAY_MS=1000
HUAXIN_RECONNECT_MAX_DELAY_MS=30000
HUAXIN_MAX_RECONNECT_ATTEMPTS=5
HUAXIN_COMMAND_QUEUE_SIZE=100
HUAXIN_TELEMETRY_LIMIT=100
