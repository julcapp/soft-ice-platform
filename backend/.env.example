NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL is the MVP backend database.
# Replace CHANGE_ME with an ephemeral local password; never commit the real value.
DATABASE_URL=postgresql://soft_ice_platform:CHANGE_ME@localhost:5432/soft_ice_platform?schema=public
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=5

# Telegram Mini App authentication and public UGC publishing.
# Use real tokens only in a secure runtime environment, never in source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# YooKassa payments, recurring payments, receipts, refunds and financial reconciliation.
# Never commit production credentials. YOOKASSA_RECEIPT_VAT_CODE must match the merchant's real tax configuration.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_ORIGINS=https://app.utimoshi.ru
YOOKASSA_RECEIPT_VAT_CODE=
PRIVATE_CHANNEL_PAYMENT_RETURN_URL=
PRIVATE_CHANNEL_RENEWALS_ENABLED=false
PRIVATE_CHANNEL_RENEWAL_BATCH_SIZE=100
# Readiness flags are evidence of a completed production integration check, not feature toggles.
YOOKASSA_PAYMENT_WEBHOOK_VERIFIED=false
YOOKASSA_REFUND_WEBHOOK_VERIFIED=false
EMAIL_DELIVERY_VERIFIED=false
YOOKASSA_SETTLEMENT_REGISTRY_ENABLED=false

# Automated YooKassa daily registry import from the dedicated Yandex Mail folder.
# Use a Yandex application password only; never the primary mailbox password.
YOOKASSA_REPORT_IMAP_HOST=imap.yandex.ru
YOOKASSA_REPORT_IMAP_PORT=993
YOOKASSA_REPORT_IMAP_USER=
YOOKASSA_REPORT_IMAP_APP_PASSWORD=
YOOKASSA_REPORT_IMAP_FOLDER=юкасса отчеты
YOOKASSA_REPORT_IMAP_SENDER=reports@yoomoney.ru
YOOKASSA_REPORT_IMAP_TLS_REJECT_UNAUTHORIZED=true
# Reports normally arrive around 08:00 Tomsk / 04:00 Moscow. One-hour safety window before raising MISSING.
YOOKASSA_REPORT_EXPECTED_BY_MSK_HOUR=5

# Operations dispatch escalation delivery.
# Platform Customer/User ID that receives L2 owner escalations. Configure only in runtime env.
OPERATIONS_PLATFORM_OWNER_USER_ID=

# Photo Verification Agent / UGC publication.
PHOTO_UPLOAD_DIR=
PHOTO_CAPTURE_CHALLENGE_SECRET=
PHOTO_CAPTURE_CHALLENGE_TTL_SECONDS=180
PHOTO_VISION_MODEL=
OPENAI_API_KEY=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
MAX_BOT_TOKEN=
MAX_CHANNEL_CHAT_ID=
# Public targets fixed in code: VK club239119350, Telegram @ice_robo_club, MAX https://max.ru/channel_soft_icecream.
# Resolve MAX_CHANNEL_CHAT_ID after the bot receives a channel update: npm run max:resolve-chat-id
# SharpImageDecoder loads `sharp` lazily. CI verifies sharp@0.35.3 on Node 20; commit its lockfile through a reproducible npm install before production packaging.

# Guarded real-publication smoke test. Keep disabled by default.
PHOTO_PUBLISH_SMOKE_CONFIRM=NO
PHOTO_PUBLISH_SMOKE_IMAGE=
PHOTO_PUBLISH_SMOKE_CAPTION=
# Set PHOTO_PUBLISH_SMOKE_CONFIRM=YES only for an intentional one-image VK/Telegram/MAX integration test.

# Promotion notification worker and channel gateways.
# These URLs point to server-side bot/channel gateways; channel secrets never go to Mini App.
PROMOTION_DEEP_LINK=https://app.utimoshi.ru/
PROMOTION_TELEGRAM_DISPATCH_URL=
PROMOTION_TELEGRAM_DISPATCH_TOKEN=
PROMOTION_MAX_DISPATCH_URL=
PROMOTION_MAX_DISPATCH_TOKEN=
PROMOTION_VK_DISPATCH_URL=
PROMOTION_VK_DISPATCH_TOKEN=
PROMOTION_NOTIFICATION_MACHINE_ID=
PROMOTION_NOTIFICATION_TOLERANCE_SECONDS=75
# Shared server-to-server secret used only by channel gateways to report real delivery receipts.
PROMOTION_ANALYTICS_INGEST_TOKEN=

# Platform infrastructure. Secrets are supplied by the deployment environment.
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
FEATURE_PAYMENTS_ENABLED=false
FEATURE_MACHINE_DISPATCH_ENABLED=false

# Local Docker Compose PostgreSQL settings.
POSTGRES_DB=soft_ice_platform
POSTGRES_USER=soft_ice_platform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
HUAXIN_MACHINE_ID=huaxin_default
HUAXIN_HEARTBEAT_INTERVAL_MS=15000
HUAXIN_HEARTBEAT_TIMEOUT_MS=45000
HUAXIN_COMMAND_TIMEOUT_MS=5000
HUAXIN_RECONNECT_BASE_DELAY_MS=1000
HUAXIN_RECONNECT_MAX_DELAY_MS=30000
HUAXIN_MAX_RECONNECT_ATTEMPTS=5
HUAXIN_COMMAND_QUEUE_SIZE=100
HUAXIN_TELEMETRY_LIMIT=100


# Bot Core, Telegram/MAX transport, referrals and welcome bonus.
# Keep real credentials only in secure runtime environment files.
BOT_WEBHOOKS_ENABLED=false
BOT_MINI_APP_URL=https://app.utimoshi.ru
BOT_SMART_LINK_URL=https://go.utimoshi.ru/start
BOT_TELEGRAM_CHANNEL_URL=
BOT_MAX_CHANNEL_URL=
TELEGRAM_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET=
TELEGRAM_TEST_BOT_TOKEN=
TELEGRAM_TEST_WEBHOOK_URL=
TELEGRAM_TEST_DROP_PENDING_UPDATES=false
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
# Telegram Bot API 10.3 staged rollout. Keep disabled until test-bot verification.
TELEGRAM_RICH_MESSAGES_ENABLED=false
TELEGRAM_EPHEMERAL_MESSAGES_ENABLED=false
TELEGRAM_DISABLED_BUTTONS_ENABLED=false
MAX_TEST_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
