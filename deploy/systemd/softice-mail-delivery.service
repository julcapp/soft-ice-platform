[Unit]
Description=Soft ICE transactional email delivery worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=softice
Group=softice
WorkingDirectory=/home/julcapp/soft-ice-worktrees/max-miniapp-gateway/backend
EnvironmentFile=/etc/softice/mail-delivery.env
ExecStart=/usr/bin/node scripts/mail-delivery-worker.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
