# Copy to /etc/softice/mail-delivery.env with mode 0600.
# Never commit real credentials.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

MAIL_SMTP_HOST=smtp.provider.example
MAIL_SMTP_PORT=465
MAIL_SMTP_MODE=implicit_tls
MAIL_SMTP_USER=no-reply@utimoshi.ru
MAIL_SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@utimoshi.ru
MAIL_REPLY_TO=
MAIL_SMTP_HELO=mail.utimoshi.ru
MAIL_SMTP_TIMEOUT_MS=20000

MAIL_POLL_INTERVAL_MS=5000
MAIL_BATCH_SIZE=20
MAIL_MAX_ATTEMPTS=6
MAIL_BACKOFF_SECONDS=60,300,1800,7200,21600,43200
