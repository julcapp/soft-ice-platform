# SMTP provider
MAIL_SMTP_HOST=mail.hostland.ru
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=no-reply@utimoshi.ru
MAIL_SMTP_PASSWORD=CHANGE_ME
MAIL_SMTP_FROM=no-reply@utimoshi.ru

# Optional reply address for customer responses.
# Prefer a monitored support mailbox.
MAIL_REPLY_TO=

# Worker tuning
MAIL_POLL_INTERVAL_MS=10000
MAIL_BATCH_SIZE=20
MAIL_MAX_ATTEMPTS=5
MAIL_STALE_SENDING_MS=300000
