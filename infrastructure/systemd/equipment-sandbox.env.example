# Soft ICE Equipment Integration Sandbox
# Copy to /etc/soft-ice/equipment-sandbox.env and chmod 600.
# Never commit the real key.

NODE_ENV=test
HOST=127.0.0.1
PORT=8791
LOG_LEVEL=info

FEATURE_EQUIPMENT_INTEGRATION_ENABLED=true
EQUIPMENT_INTEGRATION_API_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# Existing backend defaults remain disabled for this isolated sandbox process.
FEATURE_PAYMENTS_ENABLED=false
FEATURE_MACHINE_DISPATCH_ENABLED=false
